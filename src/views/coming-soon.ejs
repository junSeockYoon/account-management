<%- include('partials/open') %>
<section class="rounded-[20px] border border-[#E5E8EB] bg-white px-6 py-16 text-center">
  <p class="text-[13px] font-semibold text-[#3182F6]">준비 중</p>
  <h2 class="mt-2 text-[22px] font-bold"><%= pageTitle %></h2>
  <p class="mx-auto mt-3 max-w-md text-[15px] leading-6 text-[#6B7684]">
    <%= typeof message !== 'undefined' && message ? message : '이 화면은 다음 단계에서 이어서 구현합니다.' %>
  </p>
</section>
<%- include('partials/close') %>
