<%- include('partials/open') %>
<% if (flash.error) { %>
  <p class="mb-4 rounded-2xl bg-[#FFF1F1] px-4 py-3 text-[14px] font-medium text-[#F04452]" role="alert"><%= flash.error %></p>
<% } %>
<% if (flash.notice) { %>
  <p class="mb-4 rounded-2xl bg-[#E8F8F3] px-4 py-3 text-[14px] font-medium text-[#087F5B]" role="status"><%= flash.notice %></p>
<% } %>
<% const deltaClass = dashboard.expenseDelta.direction === 'up'
  ? 'text-[#F04452]'
  : dashboard.expenseDelta.direction === 'down'
    ? 'text-[#3182F6]'
    : 'text-[#191F28]'; %>

<section class="grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="자산 요약">
  <article class="rounded-[20px] border border-[#E5E8EB] bg-white p-6">
    <p class="text-[13px] font-medium text-[#6B7684]">총 순자산</p>
    <p class="mt-2 text-[28px] font-bold leading-tight tabular-nums"><%= dashboard.netWorth.text %></p>
    <p class="mt-3 text-[13px] leading-5 text-[#8B95A1]">
      총자산 <%= dashboard.assets.text %> − 부채 <%= dashboard.liabilities.text %>
    </p>
  </article>
  <article class="rounded-[20px] border border-[#E5E8EB] bg-white p-6">
    <p class="text-[13px] font-medium text-[#6B7684]"><%= dashboard.monthExpense.label %></p>
    <p class="mt-2 text-[28px] font-bold leading-tight tabular-nums"><%= dashboard.monthExpense.text %></p>
    <p class="mt-3 text-[13px] leading-5 text-[#8B95A1]"><%= dashboard.monthExpense.rangeLabel %><br><%= dashboard.monthExpense.detail %></p>
  </article>
  <article class="rounded-[20px] border border-[#E5E8EB] bg-white p-6">
    <p class="text-[13px] font-medium text-[#6B7684]">전월 동기간 대비</p>
    <p class="mt-2 text-[28px] font-bold leading-tight tabular-nums <%= deltaClass %>"><%= dashboard.expenseDelta.text %></p>
    <p class="mt-3 text-[13px] leading-5 text-[#8B95A1]">
      <%= dashboard.expenseDelta.caption %><br>
      <%= dashboard.expenseDelta.previousRangeLabel %> 지출 <%= dashboard.expenseDelta.previousText %><br>
      비교는 입력한 거래만 사용합니다
    </p>
  </article>
</section>

<section class="mt-4 rounded-[20px] border border-[#E5E8EB] bg-white p-6">
  <h2 class="text-[17px] font-bold">순자산 추이</h2>
  <p class="mt-1 text-[13px] text-[#8B95A1]">이번 달은 화면을 열 때마다 지금 금액으로 다시 저장합니다. 지난달은 그달에 남겨 둔 금액입니다.</p>
  <% if (dashboard.history.length === 0) { %>
    <p class="mt-8 text-[14px] text-[#8B95A1]">아직 기록된 달이 없습니다.</p>
  <% } else { %>
    <div class="mt-4 h-64">
      <canvas id="net-worth-chart" aria-label="최근 순자산 추이"></canvas>
    </div>
  <% } %>
</section>

<%- include('partials/card-limit', { budget: dashboard.cardLimit, next: 'home' }) %>

<section class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-5">
  <article class="rounded-[20px] border border-[#E5E8EB] bg-white p-6 lg:col-span-3">
    <h2 class="text-[17px] font-bold">자산 포트폴리오</h2>
    <p class="mt-1 text-[13px] text-[#8B95A1]">현금성, 안전자산, 투자자산 비중</p>
    <div class="mt-6 flex flex-col items-center gap-6 sm:flex-row sm:items-center">
      <div class="relative h-56 w-56 shrink-0">
        <canvas id="portfolio-chart" aria-label="자산 포트폴리오 도넛 차트"></canvas>
        <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center">
          <span class="text-[12px] text-[#8B95A1]">총자산</span>
          <span class="text-[18px] font-bold tabular-nums"><%= dashboard.assets.compact %></span>
        </div>
      </div>
      <ul class="w-full flex-1 divide-y divide-[#F2F4F6]">
        <% dashboard.portfolio.forEach((item) => { %>
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="flex min-w-0 items-center gap-3">
              <span class="h-2.5 w-2.5 shrink-0 rounded-full" style="background: <%= item.color %>"></span>
              <div class="min-w-0">
                <p class="font-semibold"><%= item.name %></p>
                <p class="truncate text-[12px] text-[#8B95A1]"><%= item.description %></p>
              </div>
            </div>
            <div class="text-right">
              <p class="font-bold tabular-nums"><%= item.text %></p>
              <p class="text-[12px] text-[#8B95A1] tabular-nums"><%= item.shareText %></p>
            </div>
          </li>
        <% }) %>
      </ul>
    </div>
    <p class="mt-4 text-[12px] text-[#8B95A1]"><%= dashboard.fxLabel %></p>
  </article>

  <article class="rounded-[20px] border border-[#E5E8EB] bg-white p-6 lg:col-span-2">
    <h2 class="text-[17px] font-bold">이번 달 지출 TOP 3</h2>
    <p class="mt-1 text-[13px] text-[#8B95A1]"><%= dashboard.monthExpense.rangeLabel %> 카테고리 비중</p>
    <% if (dashboard.topCategories.length === 0) { %>
      <p class="mt-8 text-[14px] text-[#8B95A1]">이번 달 지출 내역이 없습니다.</p>
    <% } else { %>
      <ol class="mt-6 space-y-5">
        <% dashboard.topCategories.forEach((category, index) => { %>
          <li>
            <div class="flex items-center justify-between gap-3">
              <div class="flex min-w-0 items-center gap-3">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#F2F4F6] text-[13px] font-bold text-[#4E5968]"><%= index + 1 %></span>
                <span class="truncate font-semibold"><%= category.name %></span>
              </div>
              <div class="text-right">
                <p class="font-bold tabular-nums"><%= category.text %></p>
                <p class="text-[12px] text-[#8B95A1] tabular-nums"><%= category.shareText %></p>
              </div>
            </div>
            <div class="mt-3 h-2 overflow-hidden rounded-full bg-[#F2F4F6]" aria-hidden="true">
              <div class="h-full rounded-full" style="width: <%= category.bar %>%; background: <%= category.color %>"></div>
            </div>
          </li>
        <% }) %>
      </ol>
    <% } %>
  </article>
</section>

<section class="mt-4 rounded-[20px] border border-[#E5E8EB] bg-white p-6">
  <h2 class="text-[17px] font-bold">예·적금·청약 만기</h2>
  <p class="mt-1 text-[13px] text-[#8B95A1]">만기일이 가까운 순서입니다</p>
  <% if (dashboard.maturities.length === 0) { %>
    <p class="mt-8 text-[14px] text-[#8B95A1]">등록된 예금, 적금, 청약이 없습니다.</p>
  <% } else { %>
    <ul class="mt-4 divide-y divide-[#F2F4F6]">
      <% dashboard.maturities.forEach((item) => { %>
        <li class="flex items-center justify-between gap-4 py-4">
          <div class="min-w-0">
            <p class="text-[12px] text-[#8B95A1]"><%= item.kind %> · <%= item.bankName %></p>
            <p class="mt-1 truncate font-semibold"><%= item.name %></p>
            <p class="mt-1 text-[13px] tabular-nums text-[#4E5968]"><%= item.amountText %> · 만기 <%= item.dateLabel %></p>
          </div>
          <span class="shrink-0 rounded-full px-3 py-1 text-[13px] font-semibold tabular-nums <%= item.urgent ? 'bg-[#FFF1F1] text-[#F04452]' : 'bg-[#F2F4F6] text-[#4E5968]' %>">
            <%= item.ddayLabel %>
          </span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<script id="portfolio-data" type="application/json"><%- safeJson(dashboard.portfolio) %></script>
<script id="net-worth-data" type="application/json"><%- safeJson(dashboard.history) %></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js"></script>
<script src="/js/dashboard.js"></script>
<%- include('partials/close') %>
