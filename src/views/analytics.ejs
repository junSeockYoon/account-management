<%- include('partials/open') %>

<section class="grid grid-cols-1 gap-3 sm:grid-cols-3" aria-label="이번 달 지출">
  <article class="rounded-[20px] border border-[#E5E8EB] bg-white px-5 py-4">
    <p class="text-[13px] text-[#6B7684]">이번 달 지출</p>
    <p class="mt-1 text-[22px] font-bold tabular-nums"><%= report.monthExpense.text %></p>
    <p class="mt-2 text-[12px] text-[#8B95A1]"><%= report.rangeLabel %> · 이체 제외</p>
  </article>
  <article class="rounded-[20px] border border-[#E5E8EB] bg-white px-5 py-4">
    <p class="text-[13px] text-[#6B7684]">고정비</p>
    <p class="mt-1 text-[22px] font-bold tabular-nums"><%= report.fixed.text %></p>
    <p class="mt-2 text-[12px] text-[#8B95A1] tabular-nums"><%= report.fixed.shareText %></p>
  </article>
  <article class="rounded-[20px] border border-[#E5E8EB] bg-white px-5 py-4">
    <p class="text-[13px] text-[#6B7684]">변동비</p>
    <p class="mt-1 text-[22px] font-bold tabular-nums"><%= report.variable.text %></p>
    <p class="mt-2 text-[12px] text-[#8B95A1] tabular-nums"><%= report.variable.shareText %></p>
  </article>
</section>

<section class="mt-4 rounded-[20px] border border-[#E5E8EB] bg-white p-6">
  <h2 class="text-[17px] font-bold">6개월 지출</h2>
  <p class="mt-1 text-[13px] text-[#8B95A1]">이번 달은 기준일까지입니다</p>
  <div class="mt-4 h-64">
    <canvas id="trend-chart" aria-label="최근 6개월 지출 막대 차트"></canvas>
  </div>
</section>

<section class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <article class="rounded-[20px] border border-[#E5E8EB] bg-white p-6">
    <h2 class="text-[17px] font-bold">고정비 · 변동비</h2>
    <p class="mt-1 text-[13px] text-[#8B95A1]"><%= report.rangeLabel %></p>
    <div class="mt-5 flex h-3 overflow-hidden rounded-full bg-[#F2F4F6]" aria-hidden="true">
      <div class="h-full bg-[#3182F6]" style="width: <%= report.fixed.share %>%"></div>
      <div class="h-full bg-[#6D5EF9]" style="width: <%= report.variable.share %>%"></div>
    </div>
    <ul class="mt-4 space-y-3">
      <li class="flex items-center justify-between gap-3">
        <span class="flex items-center gap-2 text-[14px]"><span class="h-2.5 w-2.5 rounded-full bg-[#3182F6]"></span>고정비</span>
        <span class="font-semibold tabular-nums"><%= report.fixed.text %> · <%= report.fixed.shareText %></span>
      </li>
      <li class="flex items-center justify-between gap-3">
        <span class="flex items-center gap-2 text-[14px]"><span class="h-2.5 w-2.5 rounded-full bg-[#6D5EF9]"></span>변동비</span>
        <span class="font-semibold tabular-nums"><%= report.variable.text %> · <%= report.variable.shareText %></span>
      </li>
    </ul>
  </article>

  <article class="rounded-[20px] border border-[#E5E8EB] bg-white p-6">
    <h2 class="text-[17px] font-bold">카드 실적</h2>
    <p class="mt-1 text-[13px] text-[#8B95A1]">이번 달 사용액과 실적 기준</p>
    <% if (report.cards.length === 0) { %>
      <p class="mt-8 text-[14px] text-[#8B95A1]">등록된 카드가 없습니다.</p>
    <% } else { %>
      <ul class="mt-5 space-y-5">
        <% report.cards.forEach((card) => { %>
          <li>
            <div class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate font-semibold"><%= card.name %></p>
                <p class="text-[12px] text-[#8B95A1]"><%= card.kind %> · 기준 <%= card.thresholdText %></p>
              </div>
              <div class="text-right">
                <p class="font-bold tabular-nums"><%= card.amountText %></p>
                <% if (card.percentText) { %>
                  <p class="text-[12px] tabular-nums <%= card.met ? 'text-[#087F5B]' : 'text-[#8B95A1]' %>"><%= card.met ? '달성' : '진행' %> <%= card.percentText %></p>
                <% } %>
              </div>
            </div>
            <div class="mt-3 h-2 overflow-hidden rounded-full bg-[#F2F4F6]" aria-hidden="true">
              <div class="h-full rounded-full <%= card.met ? 'bg-[#12B886]' : 'bg-[#3182F6]' %>" style="width: <%= card.bar %>%"></div>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </article>
</section>

<section class="mt-4 rounded-[20px] border border-[#E5E8EB] bg-white p-6">
  <h2 class="text-[17px] font-bold">카테고리</h2>
  <p class="mt-1 text-[13px] text-[#8B95A1]">건수, 합계, 평균 · <%= report.rangeLabel %></p>
  <% if (report.categories.length === 0) { %>
    <p class="mt-8 text-[14px] text-[#8B95A1]">이번 달 지출 내역이 없습니다.</p>
  <% } else { %>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[520px] text-left text-[14px]">
        <thead class="text-[12px] text-[#8B95A1]">
          <tr>
            <th class="py-2 font-medium">카테고리</th>
            <th class="py-2 text-right font-medium">건수</th>
            <th class="py-2 text-right font-medium">합계</th>
            <th class="py-2 text-right font-medium">평균</th>
            <th class="py-2 text-right font-medium">비중</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#F2F4F6]">
          <% report.categories.forEach((row) => { %>
            <tr>
              <td class="py-3 font-semibold">
                <span class="mr-2 inline-block h-2.5 w-2.5 rounded-full" style="background: <%= row.color %>"></span><%= row.name %>
              </td>
              <td class="py-3 text-right tabular-nums text-[#4E5968]"><%= row.count %></td>
              <td class="py-3 text-right font-semibold tabular-nums"><%= row.amountText %></td>
              <td class="py-3 text-right tabular-nums text-[#4E5968]"><%= row.averageText %></td>
              <td class="py-3 text-right tabular-nums text-[#8B95A1]"><%= row.shareText %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<script id="trend-data" type="application/json"><%- safeJson(report.trend) %></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js"></script>
<script src="/js/analytics.js"></script>
<%- include('partials/close') %>
