<%- include('partials/open') %>
<% const field = 'mt-1 w-full rounded-xl border border-[#E5E8EB] bg-white px-3 py-3 text-[15px] outline-none focus:border-[#3182F6]'; %>
<% const values = page.form; %>

<a href="/transactions" class="mb-4 inline-flex text-[13px] font-semibold text-[#3182F6]">거래 내역</a>

<% if (page.error) { %>
  <p class="mb-4 rounded-2xl bg-[#FFF1F1] px-4 py-3 text-[14px] font-medium text-[#F04452]" role="alert"><%= page.error %></p>
<% } %>
<% if (page.notice) { %>
  <p class="mb-4 rounded-2xl bg-[#E8F8F3] px-4 py-3 text-[14px] font-medium text-[#087F5B]" role="status"><%= page.notice %></p>
<% } %>

<section id="tx-entry" data-as-of="<%= page.asOf %>" class="rounded-[20px] border border-[#E5E8EB] bg-white p-6">
  <form data-editor method="post" action="<%= page.editingId ? '/transactions/' + page.editingId + '/update' : '/transactions' %>" autocomplete="off">
    <h2 class="text-[17px] font-bold"><%= page.editingId ? '거래 수정' : '거래 입력' %></h2>
    <p class="mt-1 text-[13px] leading-5 text-[#8B95A1]">금액부터 적으면 됩니다. 저장하면 거래 내역으로 돌아갑니다. 체크·현금·계좌는 잔액이 줄고, 새로 넣는 신용카드 지출은 미결제 금액에 더해집니다.</p>
    <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <label class="block text-[13px] font-medium text-[#4E5968] sm:col-span-2">금액
        <input name="amount" required inputmode="numeric" value="<%= values.amount %>" class="mt-1 w-full rounded-2xl border border-[#E5E8EB] px-4 py-4 text-[28px] font-bold tabular-nums outline-none focus:border-[#3182F6]" placeholder="12000">
      </label>
      <label class="block text-[13px] font-medium text-[#4E5968]">날짜<input name="date" type="date" required value="<%= values.date %>" class="<%= field %>"></label>
      <label class="block text-[13px] font-medium text-[#4E5968]">유형
        <select name="type" class="<%= field %>">
          <option value="expense" <%= values.type === 'expense' ? 'selected' : '' %>>지출</option>
          <option value="income" <%= values.type === 'income' ? 'selected' : '' %>>수입</option>
          <option value="transfer" <%= values.type === 'transfer' ? 'selected' : '' %>>이체</option>
        </select>
      </label>
      <div data-for="payment">
        <label class="block text-[13px] font-medium text-[#4E5968]">결제 수단
          <select name="paymentMethod" class="<%= field %>">
            <option value="card" <%= values.paymentMethod === 'card' ? 'selected' : '' %>>카드</option>
            <option value="account" <%= values.paymentMethod === 'account' ? 'selected' : '' %>>계좌</option>
            <option value="cash" <%= values.paymentMethod === 'cash' ? 'selected' : '' %>>현금</option>
          </select>
        </label>
      </div>
      <div data-for="card">
        <label class="block text-[13px] font-medium text-[#4E5968]">카드
          <select name="cardId" class="<%= field %>">
            <% page.cards.forEach((item) => { %>
              <option value="<%= item.id %>" <%= values.cardId === item.id ? 'selected' : '' %>><%= item.label %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <div data-for="account" hidden>
        <label class="block text-[13px] font-medium text-[#4E5968]"><span data-account-label>출금 계좌</span>
          <select name="accountId" class="<%= field %>">
            <% page.accounts.forEach((item) => { %>
              <option value="<%= item.id %>" <%= values.accountId === item.id ? 'selected' : '' %>><%= item.label %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <div data-for="destination" hidden>
        <label class="block text-[13px] font-medium text-[#4E5968]">입금 대상
          <select name="toAsset" class="<%= field %>">
            <% page.targets.forEach((item) => { %>
              <option value="<%= item.value %>" <%= values.toAsset === item.value ? 'selected' : '' %>><%= item.label %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <label class="block text-[13px] font-medium text-[#4E5968]">카테고리
        <select name="categoryId" class="<%= field %>">
          <% page.categories.forEach((item) => { %>
            <option value="<%= item.id %>" data-group="<%= item.group %>" <%= values.categoryId === item.id ? 'selected' : '' %>><%= item.name %></option>
          <% }) %>
        </select>
      </label>
      <div data-for="class">
        <label class="block text-[13px] font-medium text-[#4E5968]">고정/변동
          <select name="expenseClass" class="<%= field %>">
            <option value="variable" <%= values.expenseClass !== 'fixed' ? 'selected' : '' %>>변동비</option>
            <option value="fixed" <%= values.expenseClass === 'fixed' ? 'selected' : '' %>>고정비</option>
          </select>
        </label>
      </div>
      <label class="block text-[13px] font-medium text-[#4E5968] sm:col-span-2">메모<input name="memo" maxlength="80" value="<%= values.memo %>" class="<%= field %>" placeholder="점심, 커피처럼 짧게"></label>
    </div>
    <div class="mt-6 flex justify-end gap-2">
      <a href="/transactions" class="rounded-full px-4 py-3 text-[14px] font-semibold text-[#4E5968]">취소</a>
      <button type="submit" class="rounded-full bg-[#3182F6] px-5 py-3 text-[15px] font-semibold text-white">저장</button>
    </div>
  </form>
</section>

<details class="group mt-4 rounded-[20px] border border-[#E5E8EB] bg-white p-6" <%= page.recurring.length ? 'open' : '' %>>
  <summary class="cursor-pointer list-none text-[17px] font-bold [&::-webkit-details-marker]:hidden">매달 고정 지출 <span class="ml-1 text-[13px] font-medium text-[#8B95A1]"><%= page.recurring.length %>건</span></summary>
  <p class="mt-3 text-[13px] leading-5 text-[#8B95A1]">기준일에 그 날이 지나면 고정비 거래가 한 번 생깁니다. 새로 생긴 신용카드 지출은 미결제에 더해지고, 거래 내역에서 체크하면 다시 빼집니다.</p>
  <form data-recurring method="post" action="/recurring" class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2" autocomplete="off">
    <label class="block text-[13px] font-medium text-[#4E5968]">금액<input name="amount" required inputmode="numeric" class="<%= field %>" placeholder="55000"></label>
    <label class="block text-[13px] font-medium text-[#4E5968]">매달<input name="chargeDay" required inputmode="numeric" class="<%= field %>" placeholder="5"></label>
    <label class="block text-[13px] font-medium text-[#4E5968]">카테고리
      <select name="categoryId" class="<%= field %>">
        <% page.categories.forEach((item) => { if (item.group !== 'expense') return; %>
          <option value="<%= item.id %>"><%= item.name %></option>
        <% }) %>
      </select>
    </label>
    <label class="block text-[13px] font-medium text-[#4E5968]">결제 수단
      <select name="paymentMethod" class="<%= field %>">
        <option value="card" selected>카드</option>
        <option value="account">계좌</option>
        <option value="cash">현금</option>
      </select>
    </label>
    <div data-recurring-card>
      <label class="block text-[13px] font-medium text-[#4E5968]">카드
        <select name="cardId" class="<%= field %>">
          <% page.cards.forEach((item) => { %>
            <option value="<%= item.id %>"><%= item.label %></option>
          <% }) %>
        </select>
      </label>
    </div>
    <div data-recurring-account hidden>
      <label class="block text-[13px] font-medium text-[#4E5968]">계좌
        <select name="accountId" class="<%= field %>">
          <% page.accounts.forEach((item) => { %>
            <option value="<%= item.id %>"><%= item.label %></option>
          <% }) %>
        </select>
      </label>
    </div>
    <label class="block text-[13px] font-medium text-[#4E5968] sm:col-span-2">메모<input name="memo" maxlength="80" class="<%= field %>" placeholder="월세, 구독"></label>
    <div class="sm:col-span-2 flex justify-end">
      <button type="submit" class="rounded-full bg-[#3182F6] px-4 py-2 text-[14px] font-semibold text-white">추가</button>
    </div>
  </form>
  <% if (page.recurring.length === 0) { %>
    <p class="mt-4 text-[14px] text-[#8B95A1]">등록된 고정 지출이 없습니다.</p>
  <% } else { %>
    <ul class="mt-4 divide-y divide-[#F2F4F6]">
      <% page.recurring.forEach((item) => { %>
        <li class="flex items-center justify-between gap-3 py-3">
          <div class="min-w-0">
            <p class="truncate font-semibold"><%= item.title %></p>
            <p class="mt-1 truncate text-[13px] text-[#8B95A1]"><%= item.detail %></p>
          </div>
          <div class="flex shrink-0 items-center gap-3">
            <p class="font-bold tabular-nums"><%= item.amountText %></p>
            <form method="post" action="/recurring/<%= item.id %>/delete" data-confirm="<%= item.title %>">
              <button type="submit" class="rounded-full px-3 py-1.5 text-[13px] font-semibold text-[#F04452] hover:bg-[#FFF1F1]">삭제</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</details>

<script src="/js/transactions.js"></script>
<%- include('partials/close') %>
