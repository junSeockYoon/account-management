<%- include('partials/open') %>
<% const toneClass = { up: 'text-[#F04452]', down: 'text-[#3182F6]', flat: 'text-[#4E5968]' }; %>
<% const weekdayClass = { sun: 'text-[#F04452]', sat: 'text-[#3182F6]', day: 'text-[#191F28]' }; %>

<% if (page.error) { %>
  <p class="mb-4 rounded-2xl bg-[#FFF1F1] px-4 py-3 text-[14px] font-medium text-[#F04452]" role="alert"><%= page.error %></p>
<% } %>
<% if (page.notice) { %>
  <p class="mb-4 rounded-2xl bg-[#E8F8F3] px-4 py-3 text-[14px] font-medium text-[#087F5B]" role="status"><%= page.notice %><% if (page.detail) { %> <%= page.detail %><% } %></p>
<% } %>


<div class="mb-5 flex justify-end">
  <a href="/transactions/new" class="hidden rounded-full bg-[#3182F6] px-4 py-2.5 text-[14px] font-semibold text-white md:inline-flex">거래 입력</a>
</div>
<a href="/transactions/new" class="fixed bottom-[4.75rem] right-5 z-30 rounded-full bg-[#3182F6] px-5 py-3 text-[15px] font-semibold text-white shadow-[0_8px_24px_rgba(49,130,246,0.35)] md:hidden">거래 입력</a>

<section class="grid grid-cols-1 gap-3 sm:grid-cols-3" aria-label="조회 합계">
  <article class="rounded-[20px] border border-[#E5E8EB] bg-white px-5 py-4">
    <p class="text-[13px] text-[#6B7684]">지출</p>
    <p class="mt-1 text-[22px] font-bold tabular-nums text-[#3182F6]"><%= page.totals.expenseText %></p>
  </article>
  <article class="rounded-[20px] border border-[#E5E8EB] bg-white px-5 py-4">
    <p class="text-[13px] text-[#6B7684]">수입</p>
    <p class="mt-1 text-[22px] font-bold tabular-nums text-[#F04452]"><%= page.totals.incomeText %></p>
  </article>
  <article class="rounded-[20px] border border-[#E5E8EB] bg-white px-5 py-4">
    <p class="text-[13px] text-[#6B7684]">이체 <span class="text-[#8B95A1]">지출 제외</span></p>
    <p class="mt-1 text-[22px] font-bold tabular-nums"><%= page.totals.transferText %></p>
  </article>
</section>

<section class="mt-4 rounded-[20px] border border-[#E5E8EB] bg-white p-4 sm:p-6" aria-label="<%= page.calendar.label %> 달력">
  <div class="flex items-center justify-between gap-3">
    <% if (page.calendar.prevHref) { %>
      <a href="<%= page.calendar.prevHref %>" class="rounded-full px-3 py-1.5 text-[13px] font-semibold text-[#4E5968] hover:bg-[#F2F4F6]">이전</a>
    <% } else { %><span></span><% } %>
    <h2 class="text-[17px] font-bold"><%= page.calendar.label %></h2>
    <% if (page.calendar.nextHref) { %>
      <a href="<%= page.calendar.nextHref %>" class="rounded-full px-3 py-1.5 text-[13px] font-semibold text-[#4E5968] hover:bg-[#F2F4F6]">다음</a>
    <% } else { %><span></span><% } %>
  </div>
  <p class="mt-1 text-center text-[12px] text-[#8B95A1]">파랑은 지출, 빨강은 수입입니다. 이체는 빠집니다.</p>
  <div class="mt-4 grid grid-cols-7 gap-1 text-center">
    <% page.calendar.weekdays.forEach((name, index) => { %>
      <div class="pb-1 text-[12px] font-semibold <%= index === 0 ? 'text-[#F04452]' : index === 6 ? 'text-[#3182F6]' : 'text-[#8B95A1]' %>"><%= name %></div>
    <% }) %>
    <% page.calendar.cells.forEach((cell) => { %>
      <% if (cell.blank) { %>
        <div></div>
      <% } else { %>
        <a
          href="<%= cell.href %>"
          class="flex min-h-16 flex-col rounded-xl px-0.5 py-1 <%= cell.selected ? 'bg-[#E8F3FF]' : 'hover:bg-[#F9FAFB]' %> <%= cell.today ? 'ring-1 ring-[#3182F6]' : '' %>"
          <% if (cell.selected) { %>aria-current="date"<% } %>
        >
          <span class="text-[13px] font-semibold <%= cell.future ? 'text-[#B0B8C1]' : weekdayClass[cell.weekdayTone] %>"><%= cell.day %></span>
          <% if (cell.expenseText) { %><span class="truncate text-[10px] font-medium leading-4 text-[#3182F6] tabular-nums">-<%= cell.expenseText %></span><% } %>
          <% if (cell.incomeText) { %><span class="truncate text-[10px] font-medium leading-4 text-[#F04452] tabular-nums">+<%= cell.incomeText %></span><% } %>
        </a>
      <% } %>
    <% }) %>
  </div>
</section>

<form method="get" action="/transactions" class="mt-5 flex flex-col gap-2 sm:flex-row">
  <select name="month" class="rounded-xl border border-[#E5E8EB] bg-white px-3 py-3 text-[14px]" aria-label="월">
    <option value="all" <%= page.month === 'all' ? 'selected' : '' %>>전체 기간</option>
    <% page.months.forEach((item) => { %>
      <option value="<%= item.value %>" <%= page.month === item.value ? 'selected' : '' %>><%= item.label %></option>
    <% }) %>
  </select>
  <select name="type" class="rounded-xl border border-[#E5E8EB] bg-white px-3 py-3 text-[14px]" aria-label="유형">
    <% page.types.forEach((item) => { %>
      <option value="<%= item.value %>" <%= page.type === item.value ? 'selected' : '' %>><%= item.label %></option>
    <% }) %>
  </select>
  <input name="q" value="<%= page.q %>" maxlength="40" placeholder="메모, 카테고리, 카드, 계좌" class="min-w-0 flex-1 rounded-xl border border-[#E5E8EB] bg-white px-3 py-3 text-[14px] outline-none focus:border-[#3182F6]" aria-label="검색">
  <button type="submit" class="rounded-full bg-white px-4 py-3 text-[14px] font-semibold text-[#4E5968]">조회</button>
</form>

<p class="mt-6 text-[13px] leading-5 text-[#8B95A1]">신용카드 지출을 체크하면 적어 둔 미결제 금액에 이미 들어 있는 지출입니다. 체크를 끄면 그 금액이 미결제에 더해집니다.</p>
<p class="mb-3 mt-2 text-[13px] text-[#8B95A1]">
  <%= page.dayLabel || '이 조건' %> · <%= page.totals.count %>건
  <% if (page.clearDayHref) { %><a href="<%= page.clearDayHref %>" class="ml-2 font-semibold text-[#3182F6]">달 전체</a><% } %>
</p>

<% if (page.rows.length === 0) { %>
  <p class="rounded-[20px] border border-[#E5E8EB] bg-white px-6 py-12 text-center text-[14px] text-[#8B95A1]">조건에 맞는 거래가 없습니다. <a href="/transactions/new" class="font-semibold text-[#3182F6]">거래 입력</a></p>
<% } else { %>
  <ul class="divide-y divide-[#F2F4F6] overflow-hidden rounded-[20px] border border-[#E5E8EB] bg-white">
    <% page.rows.forEach((item) => { %>
      <li class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#F2F4F6] px-2.5 py-1 text-[12px] font-semibold text-[#191F28]">
              <span class="h-2 w-2 rounded-full" style="background: <%= item.categoryColor %>"></span>
              <%= item.categoryName %>
            </span>
            <% if (item.type !== 'expense') { %>
              <span class="rounded-full px-2 py-1 text-[11px] font-semibold <%= item.type === 'income' ? 'bg-[#FFF1F1] text-[#F04452]' : 'bg-[#E8F3FF] text-[#3182F6]' %>"><%= item.typeLabel %></span>
            <% } %>
            <% if (item.classLabel === '고정비') { %>
              <span class="rounded-full bg-[#F2F4F6] px-2 py-1 text-[11px] font-semibold text-[#4E5968]">고정비</span>
            <% } %>
          </div>
          <p class="mt-2 truncate font-semibold"><%= item.memo || item.where %></p>
          <p class="mt-1 truncate text-[13px] text-[#8B95A1]"><%= item.dateText %><% if (item.memo) { %> · <%= item.where %><% } %></p>
          <% if (item.statement) { %>
            <form method="post" action="/transactions/<%= item.id %>/statement" class="mt-2">
              <input type="hidden" name="month" value="<%= page.month %>">
              <input type="hidden" name="included" value="0">
              <label class="inline-flex items-center gap-2 text-[12px] font-medium text-[#4E5968]">
                <input type="checkbox" name="included" value="1" <%= item.statement.included ? 'checked' : '' %> onchange="this.form.submit()" class="h-4 w-4 accent-[#3182F6]">
                미결제 금액에 포함
              </label>
            </form>
          <% } %>
        </div>
        <div class="flex items-center justify-between gap-3 sm:justify-end">
          <p class="text-[16px] font-bold tabular-nums sm:text-right <%= toneClass[item.tone] %>"><%= item.amountText %></p>
          <div class="flex shrink-0 items-center gap-2">
            <a href="/transactions/new?id=<%= item.id %>" class="rounded-full px-3 py-1.5 text-[13px] font-semibold text-[#3182F6] hover:bg-[#E8F3FF]">수정</a>
            <form method="post" action="/transactions/<%= item.id %>/delete" data-confirm="<%= item.confirmLabel %>">
              <input type="hidden" name="month" value="<%= page.month %>">
              <button type="submit" class="rounded-full px-3 py-1.5 text-[13px] font-semibold text-[#F04452] hover:bg-[#FFF1F1]">삭제</button>
            </form>
          </div>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>

<script src="/js/transactions.js"></script>
<%- include('partials/close') %>
