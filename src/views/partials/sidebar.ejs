<aside class="hidden md:fixed md:inset-y-0 md:left-0 md:z-30 md:flex md:w-60 md:flex-col md:border-r md:border-[#E5E8EB] md:bg-white">
  <a href="/" class="block px-6 pb-2 pt-7">
    <span class="block text-[18px] font-bold tracking-tight">자산관리</span>
    <span class="mt-1 block text-[12px] text-[#8B95A1]">가계와 자산을 한곳에서</span>
  </a>
  <nav class="mt-6 flex flex-1 flex-col gap-1 px-3" aria-label="주 메뉴">
    <% navItems.forEach((item) => { %>
      <a
        href="<%= item.href %>"
        class="flex items-center gap-3 rounded-xl px-3 py-3 text-[15px] font-medium <%= item.active ? 'bg-[#E8F3FF] text-[#3182F6]' : 'text-[#4E5968] hover:bg-[#F2F4F6]' %>"
        <% if (item.active) { %>aria-current="page"<% } %>
      >
        <%- include('icon', { iconName: item.icon }) %>
        <%= item.label %>
      </a>
    <% }) %>
  </nav>
  <div class="border-t border-[#F2F4F6] px-6 py-5">
    <p class="text-[14px] font-semibold"><%= profile.name %></p>
    <p class="mt-1 text-[12px] text-[#8B95A1]">기준일 <%= asOfLabel %></p>
  </div>
</aside>
