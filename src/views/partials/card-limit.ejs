<section class="mt-4 rounded-[20px] border border-[#E5E8EB] bg-white p-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class="text-[17px] font-bold">카드 사용 한도</h2>
      <p class="mt-1 text-[13px] text-[#8B95A1]"><%= budget.rangeLabel %> · 한도는 미결제 금액과 체크하지 않은 카드 지출을 더한 값과 비교합니다.</p>
    </div>
    <form method="post" action="/card-limit" class="flex flex-wrap items-end gap-2" autocomplete="off">
      <input type="hidden" name="next" value="<%= next %>">
      <label class="text-[13px] font-medium text-[#4E5968]" for="card-limit-<%= next %>">한도
        <input id="card-limit-<%= next %>" name="amount" inputmode="numeric" value="<%= budget.input %>" placeholder="500000" class="mt-1 block w-36 rounded-xl border border-[#E5E8EB] px-3 py-2 text-[15px] font-normal tabular-nums outline-none focus:border-[#3182F6]">
      </label>
      <label class="text-[13px] font-medium text-[#4E5968]" for="card-cycle-<%= next %>">기준일
        <input id="card-cycle-<%= next %>" name="cycleDay" inputmode="numeric" value="<%= budget.cycleInput %>" placeholder="1" class="mt-1 block w-20 rounded-xl border border-[#E5E8EB] px-3 py-2 text-[15px] font-normal tabular-nums outline-none focus:border-[#3182F6]">
      </label>
      <button type="submit" class="rounded-full bg-[#3182F6] px-4 py-2 text-[14px] font-semibold text-white">저장</button>
    </form>
  </div>
  <dl class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-3">
    <div>
      <dt class="text-[12px] text-[#8B95A1]">카드 미결제</dt>
      <dd class="mt-1 text-[18px] font-bold tabular-nums"><%= budget.unpaidText %></dd>
    </div>
    <div>
      <dt class="text-[12px] text-[#8B95A1]">이후 사용</dt>
      <dd class="mt-1 text-[18px] font-bold tabular-nums"><%= budget.laterText %></dd>
    </div>
    <div>
      <dt class="text-[12px] text-[#8B95A1]">합계</dt>
      <dd class="mt-1 text-[18px] font-bold tabular-nums"><%= budget.spentText %></dd>
    </div>
  </dl>
  <p class="mt-3 text-[12px] leading-5 text-[#8B95A1]">미결제는 카드에 적어 둔 금액입니다. 이후 사용은 이 기간에 체크하지 않은 카드 지출이고, 기간 카드 결제 전체는 <%= budget.usageText %>입니다.</p>
  <% if (!budget.set) { %>
    <p class="mt-3 text-[14px] text-[#4E5968]">한도를 정하면 합계 <span class="font-semibold tabular-nums"><%= budget.spentText %></span>과 비교합니다. 한도 칸을 비우고 저장하면 한도가 지워집니다.</p>
  <% } else { %>
    <div class="mt-5 flex items-end justify-between gap-3">
      <p class="text-[22px] font-bold tabular-nums"><%= budget.spentText %><span class="text-[14px] font-medium text-[#8B95A1]"> / <%= budget.limitText %></span></p>
      <p class="text-[13px] font-semibold tabular-nums <%= budget.over ? 'text-[#F04452]' : 'text-[#4E5968]' %>">
        <% if (budget.over) { %>한도를 <%= budget.remainingText %> 넘김<% } else if (budget.met) { %>한도를 모두 씀<% } else { %>남음 <%= budget.remainingText %><% } %>
      </p>
    </div>
    <div class="mt-3 h-2 overflow-hidden rounded-full bg-[#F2F4F6]" aria-hidden="true">
      <div class="h-full rounded-full <%= budget.over ? 'bg-[#F04452]' : 'bg-[#3182F6]' %>" style="width: <%= budget.bar %>%"></div>
    </div>
    <p class="mt-2 text-[12px] text-[#8B95A1] tabular-nums"><%= budget.percentText %> · 칸을 비우고 저장하면 한도가 지워집니다</p>
  <% } %>
</section>
