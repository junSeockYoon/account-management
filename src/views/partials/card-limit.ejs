<section class="mt-4 rounded-[20px] border border-[#E5E8EB] bg-white p-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class="text-[17px] font-bold">이번 달 카드 한도</h2>
      <p class="mt-1 text-[13px] text-[#8B95A1]"><%= budget.rangeLabel %> · 카드로 결제한 지출만 합산합니다</p>
    </div>
    <form method="post" action="/card-limit" class="flex items-center gap-2" autocomplete="off">
      <input type="hidden" name="next" value="<%= next %>">
      <label class="sr-only" for="card-limit-<%= next %>">카드 한도</label>
      <input id="card-limit-<%= next %>" name="amount" inputmode="numeric" value="<%= budget.input %>" placeholder="500000" class="w-36 rounded-xl border border-[#E5E8EB] px-3 py-2 text-[15px] tabular-nums outline-none focus:border-[#3182F6]">
      <button type="submit" class="rounded-full bg-[#3182F6] px-4 py-2 text-[14px] font-semibold text-white">저장</button>
    </form>
  </div>
  <% if (!budget.set) { %>
    <p class="mt-5 text-[14px] text-[#4E5968]">한도를 정하면 이번 달 카드 사용 <span class="font-semibold tabular-nums"><%= budget.spentText %></span>과 비교합니다. 칸을 비우고 저장하면 한도가 지워집니다.</p>
  <% } else { %>
    <div class="mt-5 flex items-end justify-between gap-3">
      <p class="text-[22px] font-bold tabular-nums"><%= budget.spentText %><span class="text-[14px] font-medium text-[#8B95A1]"> / <%= budget.limitText %></span></p>
      <p class="text-[13px] font-semibold tabular-nums <%= budget.over ? 'text-[#F04452]' : 'text-[#4E5968]' %>">
        <% if (budget.over) { %>한도를 <%= budget.remainingText %> 넘김<% } else if (budget.met) { %>한도를 모두 씀<% } else { %>남음 <%= budget.remainingText %><% } %>
      </p>
    </div>
    <div class="mt-3 h-2 overflow-hidden rounded-full bg-[#F2F4F6]" aria-hidden="true">
      <div class="h-full rounded-full <%= budget.over ? 'bg-[#F04452]' : 'bg-[#3182F6]' %>" style="width: <%= budget.bar %>%"></div>
    </div>
    <p class="mt-2 text-[12px] text-[#8B95A1] tabular-nums"><%= budget.percentText %> · 칸을 비우고 저장하면 한도가 지워집니다</p>
  <% } %>
</section>
