<% const tone = spendingReport.status === 'caution'
  ? 'bg-[#FFF1F1] text-[#F04452]'
  : spendingReport.status === 'room'
    ? 'bg-[#E8F8F3] text-[#087F5B]'
    : 'bg-[#F2F4F6] text-[#4E5968]'; %>
<section class="mt-4 rounded-[20px] border border-[#E5E8EB] bg-white p-6" aria-label="지출 리포트">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h2 class="text-[17px] font-bold">지출 리포트</h2>
      <p class="mt-1 text-[13px] leading-5 text-[#8B95A1]">고정비는 빼고, 기준일까지의 변동비 속도로 이번 달을 예상합니다.</p>
    </div>
    <p class="shrink-0 rounded-full px-3 py-1 text-[13px] font-semibold <%= tone %>"><%= spendingReport.statusLabel %></p>
  </div>

  <p class="mt-5 text-[13px] text-[#6B7684]">이 속도면 이번 달 변동비</p>
  <p class="mt-1 text-[28px] font-bold leading-tight tabular-nums"><%= spendingReport.projectedText %></p>
  <p class="mt-2 text-[13px] leading-5 text-[#8B95A1]">
    <%= spendingReport.daysElapsed %>일 / <%= spendingReport.daysInMonth %>일 · 지금까지 <%= spendingReport.spentText %><br>
    <%= spendingReport.compareText %>
  </p>

  <div class="mt-5 border-t border-[#F2F4F6] pt-5">
    <h3 class="text-[15px] font-bold">자주 쓰는 소비</h3>
    <% if (spendingReport.habit) { %>
      <p class="mt-2 text-[15px] leading-6">
        <span class="mr-2 inline-block h-2.5 w-2.5 rounded-full" style="background: <%= spendingReport.habit.color %>"></span>
        <span class="font-semibold"><%= spendingReport.habit.name %></span>
        <%= spendingReport.habit.count %>회 · <%= spendingReport.habit.amountText %>
      </p>
      <p class="mt-1 text-[13px] text-[#8B95A1]">이번 달 변동비 중 횟수가 가장 많습니다.</p>
    <% } else { %>
      <p class="mt-2 text-[14px] text-[#8B95A1]">이번 달 변동비 중 3회 이상 반복된 항목이 없습니다.</p>
    <% } %>
  </div>

  <div class="mt-5 border-t border-[#F2F4F6] pt-5">
    <h3 class="text-[15px] font-bold">이번 달 하나만 줄이기</h3>
    <p class="mt-1 text-[13px] leading-5 text-[#8B95A1]">고른 카테고리의 이번 달 지출 전체와 비교합니다. 금액을 비우고 저장하면 목표가 지워집니다.</p>
    <% if (spendingReport.previousCut) { %>
      <p class="mt-3 text-[14px] font-medium text-[#4E5968]"><%= spendingReport.previousCut.line %></p>
    <% } %>
    <% if (spendingReport.cut) { %>
      <p class="mt-4 text-[22px] font-bold tabular-nums"><%= spendingReport.cut.spentText %><span class="text-[14px] font-medium text-[#8B95A1]"> / <%= spendingReport.cut.limitText %></span></p>
      <p class="text-[13px] font-semibold tabular-nums <%= spendingReport.cut.over ? 'text-[#F04452]' : 'text-[#4E5968]' %>">
        <% if (spendingReport.cut.over) { %>목표보다 <%= spendingReport.cut.remainingText %> 더 씀<% } else if (spendingReport.cut.met) { %>목표만큼 씀<% } else { %>남음 <%= spendingReport.cut.remainingText %><% } %>
      </p>
      <div class="mt-3 h-2 overflow-hidden rounded-full bg-[#F2F4F6]" aria-hidden="true">
        <div class="h-full rounded-full <%= spendingReport.cut.over ? 'bg-[#F04452]' : 'bg-[#3182F6]' %>" style="width: <%= spendingReport.cut.bar %>%"></div>
      </div>
    <% } %>
    <form method="post" action="/spending-target" class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end" autocomplete="off">
      <label class="block min-w-0 flex-1 text-[13px] font-medium text-[#4E5968]">카테고리
        <select name="categoryId" class="mt-1 w-full rounded-xl border border-[#E5E8EB] bg-white px-3 py-3 text-[15px] font-normal">
          <% spendingReport.categories.forEach((item) => { %>
            <option value="<%= item.id %>" <%= spendingReport.cut && spendingReport.cut.categoryId === item.id ? 'selected' : '' %>><%= item.name %></option>
          <% }) %>
        </select>
      </label>
      <label class="block text-[13px] font-medium text-[#4E5968]">금액
        <input name="amount" inputmode="numeric" value="<%= spendingReport.cut ? spendingReport.cut.input : '' %>" placeholder="200000" class="mt-1 w-full rounded-xl border border-[#E5E8EB] px-3 py-3 text-[15px] font-normal tabular-nums outline-none focus:border-[#3182F6] sm:w-40">
      </label>
      <button type="submit" class="rounded-full bg-[#3182F6] px-4 py-3 text-[14px] font-semibold text-white">저장</button>
    </form>
  </div>

  <p class="mt-5 rounded-2xl px-4 py-3 text-[14px] leading-6 <%= spendingReport.caution ? 'bg-[#FFF1F1] text-[#8B1E1E]' : 'bg-[#F2F4F6] text-[#4E5968]' %>" role="status"><%= spendingReport.comment %></p>
</section>
